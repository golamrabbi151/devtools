APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# Security Knowledge Base: records are public to read; adding/editing needs an AD sign-in.
# AD login API (must be https). Empty = Knowledge Base is read-only.
KB_AUTH_URL=
# "channelCode" sent with each login request.
KB_AUTH_CHANNEL=USERCODE
# Minutes a sign-in lasts before automatic sign-out.
KB_SESSION_MINUTES=30
# Birthday cards on the home page. Empty = built-in dummy data (served at /api/birthdays).
BIRTHDAY_API_URL=
# Optional bearer token for the birthday API, and how long its reply is cached (seconds).
# BIRTHDAY_API_TOKEN=
# BIRTHDAY_CACHE_SECONDS=600
# Space-separated https origins that serve the user photos (added to the CSP img-src).
# BIRTHDAY_IMAGE_ORIGINS=https://hr.example.com
# Optional: database file location (default: instance/kb.sqlite3). Keep it on a persistent volume.
# KB_DB_PATH=/srv/app/instance/kb.sqlite3
# Use Redis when running more than one worker/container so rate limits are shared:
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
